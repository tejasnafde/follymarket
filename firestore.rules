rules_version = '2';

// Nothing reaches Firestore from a browser. Follymarket's client talks only to
// the Cloud Run API, which uses the Admin SDK and bypasses these rules, so
// deny-all is the whole policy. If a client-side read is ever added, this file
// is the only place that decides who may see what.
//
// This database is shared with scout, whose backend also uses the Admin SDK.
// Deploying this changed nothing for it: the database had no ruleset at all
// before 2026-08-05.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
